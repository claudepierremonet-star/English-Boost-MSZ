{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile, school grade (6e-Terminale), CEFR level tier (A1-C2), adaptive profile, daily missions, and aggregate learning statistics.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "Scholar display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the scholar"
        },
        "photoURL": {
          "type": "string",
          "description": "Scholar avatar URL"
        },
        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"],
          "description": "Current CEFR level"
        },
        "schoolGrade": {
          "type": "string",
          "enum": ["6e", "5e", "4e", "3e", "2nde", "1re", "terminale"],
          "description": "Middle school or high school grade level"
        },
        "heroImageURL": {
          "type": "string",
          "description": "Editorial hero cut-out artwork URL"
        },
        "stats": {
          "type": "object",
          "description": "Aggregated study metrics and streaks"
        },
        "arcadeProgression": {
          "type": "object",
          "description": "Arcade progression (level 1-99, points, unlocked games and active session)"
        },
        "cityMapProgression": {
          "type": "object",
          "description": "600-level City Map quiz progression"
        },
        "englishAdventure": {
          "type": "object",
          "description": "English Adventure 7-island world progression, adaptive difficulty tiers, CEFR-calibrated dual-skill daily challenges (completedDailyChallengeIds), temporary XP multiplier boosts (activeXpBoost), stars, trophies, collectible cards, avatars, themes, and idempotent reward claim ledger"
        },
        "adaptiveProfile": {
          "type": "object",
          "description": "Centralized 7-skill adaptive evaluation profile (vocabulary, grammar, listening, reading, writing, speaking, pronunciation, speed, retention, balance)"
        },
        "ageRange": {
          "type": "string",
          "enum": ["11-12", "13-14", "15-16", "17-18+"],
          "description": "Student age range aligned with middle/high school bracket"
        },
        "learningObjectives": {
          "type": "array",
          "description": "Student personal English learning objectives (up to 8)"
        },
        "preferredDurationMinutes": {
          "type": "number",
          "description": "Preferred daily study session duration in minutes (10-180)"
        },
        "placementTest": {
          "type": "object",
          "description": "Multi-signal diagnostic placement assessment across vocabulary, grammar, reading, listening, writing, and speaking"
        },
        "dailyMissions": {
          "type": "object",
          "description": "Daily adaptive mission states and rewards"
        },
        "tutorSavedNotes": {
          "type": "array",
          "description": "Validated AI English Tutor coaching tips, writing feedback, and custom drills saved by the student (up to 40)"
        },
        "tutorWeaknesses": {
          "type": "array",
          "description": "Recurring grammar, vocabulary, structure, unnatural phrasing, and pronunciation weaknesses tracked by the AI English Tutor (up to 30)"
        },
        "favoriteLessonIds": {
          "type": "array",
          "description": "List of favorited school lesson IDs (up to 200)"
        },
        "chartAnnotations": {
          "type": "array",
          "description": "Personal text annotations pinned to the 30-day progression chart (up to 60)"
        },
        "mszCoinsBalance": {
          "type": "number",
          "description": "Current MSZ Coins balance"
        },
        "ownedCardInstances": {
          "type": "array",
          "description": "Owned collectible character cards"
        },
        "equippedCharacterId": {
          "type": "string",
          "description": "Equipped collectible card ID"
        },
        "unlockedBadgeIds": {
          "type": "array",
          "description": "Unlocked achievement badge identifiers"
        }
      },
      "required": ["uid", "level"]
    },
    "LearningAttempt": {
      "title": "LearningAttempt",
      "description": "A completed exercise, escape room, listening cinema, grammar battle, AI tutor, English Adventure mission, dictation, quiz, or speaking attempt.",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "description": "Unique attempt identifier" },
        "moduleId": { "type": "string", "description": "Source module identifier" },
        "moduleType": {
          "type": "string",
          "enum": [
            "dictation",
            "flashcard",
            "quiz",
            "speaking",
            "daily_challenge",
            "grammar",
            "reading",
            "writing",
            "escape_room",
            "listening_cinema",
            "grammar_battle",
            "tutor",
            "dialogue",
            "city_map",
            "arcade",
            "adventure",
            "smart_memory"
          ],
          "description": "Exercise modality"
        },
        "title": { "type": "string", "description": "Title of exercise or lesson" },
        "score": { "type": "number", "description": "Score achieved (0-100)" },
        "level": { "type": "string", "description": "CEFR level" },
        "completedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp" },
        "durationSeconds": { "type": "number", "description": "Time spent on attempt in seconds" },
        "details": { "type": "object", "description": "Detailed exercise metrics" }
      },
      "required": ["attemptId", "moduleType", "score", "completedAt"]
    },
    "FlashcardProgress": {
      "title": "FlashcardProgress",
      "description": "Spaced repetition (SM-2) memory schedule for a vocabulary term.",
      "type": "object",
      "properties": {
        "cardId": { "type": "string", "description": "Identifier of the vocabulary item" },
        "term": { "type": "string", "description": "Target English vocabulary term" },
        "repetitions": { "type": "number", "description": "Repetition count" },
        "intervalDays": { "type": "number", "description": "SM-2 interval in days" },
        "easeFactor": { "type": "number", "description": "SM-2 ease factor" },
        "nextReviewDate": { "type": "string", "description": "ISO timestamp for next due review" },
        "lastQualityScore": { "type": "number", "description": "Last SM-2 recall quality 0-5" },
        "state": { "type": "string", "enum": ["learning", "review", "mastered"] }
      },
      "required": ["cardId", "intervalDays", "repetitions", "easeFactor"]
    },
    "TutorSession": {
      "title": "TutorSession",
      "description": "Completed AI English Tutor coaching session summary with fluency score, strengths, and identified weaknesses.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique tutor session identifier" },
        "mode": {
          "type": "string",
          "enum": [
            "free_conversation",
            "school_english",
            "everyday_english",
            "travel_english",
            "restaurant_english",
            "job_interview",
            "debate_argumentation",
            "exam_preparation",
            "storytelling"
          ]
        },
        "modeLabel": { "type": "string" },
        "schoolGrade": { "type": "string", "enum": ["6e", "5e", "4e", "3e", "2nde", "1re", "terminale"] },
        "cefrLevel": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "turnsCount": { "type": "number" },
        "mistakesCount": { "type": "number" },
        "fluencyScore": { "type": "number" },
        "strengths": { "type": "array" },
        "weaknessesIdentified": { "type": "array" },
        "recommendedFocus": { "type": "string" },
        "encouragementEn": { "type": "string" },
        "summaryFr": { "type": "string" },
        "nextPracticePrompt": { "type": "string" },
        "xpEarned": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "mode", "turnsCount", "fluencyScore", "completedAt"]
    },
    "AdventureClaim": {
      "title": "AdventureClaim",
      "description": "Write-once immutable reward claim ledger entry preventing duplicate XP, coins, trophy, card, avatar, or theme claims in English Adventure.",
      "type": "object",
      "properties": {
        "claimId": { "type": "string", "description": "Deterministic idempotent reward claim key" },
        "islandId": { "type": "string", "description": "Origin territory ID" },
        "missionId": { "type": "string", "description": "Origin mission or milestone ID" },
        "xpAwarded": { "type": "number", "description": "XP credited for this specific claim (0-350)" },
        "coinsAwarded": { "type": "number", "description": "Coins credited for this specific claim (0-100)" },
        "accuracy": { "type": "number", "description": "Accuracy percentage achieved (0-100)" },
        "claimedAt": { "type": "string", "format": "date-time", "description": "Claim timestamp" }
      },
      "required": ["claimId", "xpAwarded", "coinsAwarded", "accuracy", "claimedAt"]
    },
    "SmartMemoryRecord": {
      "title": "SmartMemoryRecord",
      "description": "Deduplicated adaptive spaced repetition learning item (vocabulary, expression, grammar rule, or irregular verb) with recall history and timezone-aware scheduling.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "description": "Canonical deduplicated item ID" },
        "normalizedKey": { "type": "string", "description": "Normalized lowercase key preventing duplicate vocabulary records" },
        "itemType": { "type": "string", "enum": ["vocabulary", "expression", "grammar", "irregular_verb"] },
        "english": { "type": "string" },
        "french": { "type": "string" },
        "pronunciation": { "type": "string" },
        "exampleSentence": { "type": "string" },
        "cefrLevel": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "topic": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "state": { "type": "string", "enum": ["new", "learning", "review", "mastered"] },
        "repetitions": { "type": "number" },
        "intervalDays": { "type": "number" },
        "easeFactor": { "type": "number" },
        "retentionScore": { "type": "number" },
        "nextReviewDate": { "type": "string", "format": "date-time" },
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string" },
        "nextReviewLocalDay": { "type": "string" },
        "totalReviews": { "type": "number" },
        "correctReviews": { "type": "number" },
        "lastOutcome": { "type": "string", "enum": ["incorrect", "hard", "correct", "easy"] },
        "lastResponseTimeMs": { "type": "number" },
        "lastConfidence": { "type": "number" },
        "lastMode": { "type": "string" },
        "recallHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "itemId",
        "normalizedKey",
        "itemType",
        "english",
        "french",
        "cefrLevel",
        "topic",
        "difficulty",
        "state",
        "repetitions",
        "intervalDays",
        "easeFactor",
        "nextReviewDate",
        "timezone",
        "recallHistory",
        "createdAt",
        "updatedAt"
      ]
    },
    "SmartMemoryDuel": {
      "title": "SmartMemoryDuel",
      "description": "Real-time 10-card spaced repetition duel room pairing two learners on synchronized Smart Memory items with live scores and final scoreboard.",
      "type": "object",
      "properties": {
        "duelId": { "type": "string", "description": "6-character alphanumeric room identifier" },
        "status": { "type": "string", "enum": ["waiting", "active", "finished"] },
        "cefrLevel": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "mode": { "type": "string", "enum": ["mixed", "en_to_fr", "fr_to_en", "multiple_choice", "complete_sentence"] },
        "cardIds": { "type": "array", "description": "Ordered list of 10 synchronized SmartMemoryCatalogItem IDs" },
        "hostUid": { "type": "string" },
        "hostName": { "type": "string" },
        "guestUid": { "type": "string" },
        "guestName": { "type": "string" },
        "hostScore": { "type": "number" },
        "hostCorrectCount": { "type": "number" },
        "hostAnsweredCount": { "type": "number" },
        "hostTotalTimeMs": { "type": "number" },
        "hostStreak": { "type": "number" },
        "hostBestStreak": { "type": "number" },
        "hostAnswers": { "type": "array" },
        "guestScore": { "type": "number" },
        "guestCorrectCount": { "type": "number" },
        "guestAnsweredCount": { "type": "number" },
        "guestTotalTimeMs": { "type": "number" },
        "guestStreak": { "type": "number" },
        "guestBestStreak": { "type": "number" },
        "guestAnswers": { "type": "array" },
        "winnerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "duelId",
        "status",
        "cefrLevel",
        "mode",
        "cardIds",
        "hostUid",
        "hostName",
        "hostScore",
        "hostCorrectCount",
        "hostAnsweredCount",
        "hostTotalTimeMs",
        "hostStreak",
        "hostAnswers",
        "guestScore",
        "guestCorrectCount",
        "guestAnsweredCount",
        "guestTotalTimeMs",
        "guestStreak",
        "guestAnswers",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing academic grade, CEFR level, adaptive skill profile, daily missions, English Adventure progression, tutor weaknesses, and study cadence"
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": "LearningAttempt",
      "description": "Individual learning exercise attempts across all ecosystem modules including English Adventure"
    },
    "/users/{userId}/flashcardProgress/{cardId}": {
      "schema": "FlashcardProgress",
      "description": "Spaced repetition flashcard memory state"
    },
    "/users/{userId}/tutorSessions/{sessionId}": {
      "schema": "TutorSession",
      "description": "AI English Tutor session summaries and adaptive coaching diagnostics"
    },
    "/users/{userId}/adventureClaims/{claimId}": {
      "schema": "AdventureClaim",
      "description": "Write-once immutable reward claim ledger for English Adventure anti-duplication & XP fraud prevention"
    },
    "/users/{userId}/smartMemoryRecords/{itemId}": {
      "schema": "SmartMemoryRecord",
      "description": "Smart Memory adaptive spaced repetition records, recall history, and timezone-aware scheduling per canonical item"
    },
    "/smartMemoryDuels/{duelId}": {
      "schema": "SmartMemoryDuel",
      "description": "Shared real-time 10-card Smart Memory duel rooms between two players with synchronized scoreboard"
    }
  }
}
