rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile document & isolated subcollections
    // Public profile reading allowed for signed-in scholars to power the weekly leaderboard
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User private learning attempts subcollection
      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      // User private flashcard progress subcollection
      match /flashcardProgress/{cardId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
