rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCefrLevel(lvl) {
      return lvl in ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
    }

    function isValidGrade(g) {
      return g in ['6e', '5e', '4e', '3e', '2nde', '1re', 'terminale'];
    }

    function isValidAgeRange(age) {
      return age in ['11-12', '13-14', '15-16', '17-18+'];
    }

    function isValidUserPayload(data) {
      return data.keys().hasAll(['uid', 'level']) &&
        data.uid == request.auth.uid &&
        isValidCefrLevel(data.level) &&
        (!('schoolGrade' in data) || isValidGrade(data.schoolGrade)) &&
        (!('ageRange' in data) || isValidAgeRange(data.ageRange)) &&
        (!('learningObjectives' in data) || (data.learningObjectives is list && data.learningObjectives.size() <= 8)) &&
        (!('preferredDurationMinutes' in data) || (data.preferredDurationMinutes is number && data.preferredDurationMinutes >= 5 && data.preferredDurationMinutes <= 180)) &&
        (!('placementTest' in data) || data.placementTest is map) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('favoriteLessonIds' in data) || (data.favoriteLessonIds is list && data.favoriteLessonIds.size() <= 200)) &&
        (!('chartAnnotations' in data) || (data.chartAnnotations is list && data.chartAnnotations.size() <= 60)) &&
        (!('tutorSavedNotes' in data) || (data.tutorSavedNotes is list && data.tutorSavedNotes.size() <= 40)) &&
        (!('tutorWeaknesses' in data) || (data.tutorWeaknesses is list && data.tutorWeaknesses.size() <= 30)) &&
        (!('englishAdventure' in data) || isValidEnglishAdventure(data.englishAdventure));
    }

    function isValidAdventureXpBoost(boost) {
      return boost is map &&
        boost.keys().hasAll(['multiplier', 'sourceChallengeId', 'sourceChallengeTitle', 'skillPairLabelFr', 'cefrLevel', 'activatedAt', 'expiresAt']) &&
        boost.keys().hasOnly(['multiplier', 'sourceChallengeId', 'sourceChallengeTitle', 'skillPairLabelFr', 'cefrLevel', 'activatedAt', 'expiresAt']) &&
        boost.multiplier is number && boost.multiplier >= 1.0 && boost.multiplier <= 2.0 &&
        boost.sourceChallengeId is string && boost.sourceChallengeId.size() >= 1 && boost.sourceChallengeId.size() <= 100 &&
        boost.sourceChallengeTitle is string && boost.sourceChallengeTitle.size() >= 1 && boost.sourceChallengeTitle.size() <= 140 &&
        boost.skillPairLabelFr is string && boost.skillPairLabelFr.size() >= 1 && boost.skillPairLabelFr.size() <= 100 &&
        isValidCefrLevel(boost.cefrLevel) &&
        boost.activatedAt is string && boost.activatedAt.size() <= 64 &&
        boost.expiresAt is string && boost.expiresAt.size() <= 64;
    }

    function isValidEnglishAdventure(adv) {
      return adv is map &&
        (!('unlockedIslandIds' in adv) || (adv.unlockedIslandIds is list && adv.unlockedIslandIds.size() <= 7)) &&
        (!('completedMissionIds' in adv) || (adv.completedMissionIds is list && adv.completedMissionIds.size() <= 64)) &&
        (!('bossDefeatedIslandIds' in adv) || (adv.bossDefeatedIslandIds is list && adv.bossDefeatedIslandIds.size() <= 7)) &&
        (!('claimedRewardIds' in adv) || (adv.claimedRewardIds is list && adv.claimedRewardIds.size() <= 180)) &&
        (!('unlockedTrophyIds' in adv) || (adv.unlockedTrophyIds is list && adv.unlockedTrophyIds.size() <= 30)) &&
        (!('unlockedAvatarIds' in adv) || (adv.unlockedAvatarIds is list && adv.unlockedAvatarIds.size() <= 20)) &&
        (!('unlockedThemeIds' in adv) || (adv.unlockedThemeIds is list && adv.unlockedThemeIds.size() <= 12)) &&
        (!('unlockedCardIds' in adv) || (adv.unlockedCardIds is list && adv.unlockedCardIds.size() <= 30)) &&
        (!('completedDailyChallengeIds' in adv) || (adv.completedDailyChallengeIds is list && adv.completedDailyChallengeIds.size() <= 60 && (adv.completedDailyChallengeIds.size() == 0 || adv.completedDailyChallengeIds[0] is string))) &&
        (!('activeXpBoost' in adv) || adv.activeXpBoost == null || isValidAdventureXpBoost(adv.activeXpBoost)) &&
        (!('equippedAvatarId' in adv) || (adv.equippedAvatarId is string && adv.equippedAvatarId.size() <= 64)) &&
        (!('updatedAt' in adv) || (adv.updatedAt is string && adv.updatedAt.size() <= 64)) &&
        (!('consecutiveHighAccuracyCount' in adv) || (adv.consecutiveHighAccuracyCount is number && adv.consecutiveHighAccuracyCount >= 0 && adv.consecutiveHighAccuracyCount <= 500)) &&
        (!('totalStars' in adv) || (adv.totalStars is number && adv.totalStars >= 0 && adv.totalStars <= 150)) &&
        (!('adventureXpEarned' in adv) || (adv.adventureXpEarned is number && adv.adventureXpEarned >= 0 && adv.adventureXpEarned <= 50000)) &&
        (!('adventureCoinsEarned' in adv) || (adv.adventureCoinsEarned is number && adv.adventureCoinsEarned >= 0 && adv.adventureCoinsEarned <= 10000));
    }

    function isValidXpUpdate(oldData, newData) {
      return !('stats' in newData) || (
        newData.stats is map &&
        (!('totalXp' in newData.stats) || (
          newData.stats.totalXp is number &&
          newData.stats.totalXp >= 0 &&
          newData.stats.totalXp <= 2000000 &&
          (
            !('stats' in oldData) ||
            !(oldData.stats is map) ||
            !('totalXp' in oldData.stats) ||
            !(oldData.stats.totalXp is number) ||
            (newData.stats.totalXp - oldData.stats.totalXp) <= 5000
          )
        )) &&
        (!('weeklyXp' in newData.stats) || (newData.stats.weeklyXp is number && newData.stats.weeklyXp >= 0 && newData.stats.weeklyXp <= 500000))
      );
    }

    function isValidAdventureDelta(oldData, newData) {
      return !('englishAdventure' in newData) || (
        isValidEnglishAdventure(newData.englishAdventure) &&
        (
          !('englishAdventure' in oldData) || !(oldData.englishAdventure is map)
            ? (
                (!('adventureXpEarned' in newData.englishAdventure) || newData.englishAdventure.adventureXpEarned <= 1500) &&
                (!('adventureCoinsEarned' in newData.englishAdventure) || newData.englishAdventure.adventureCoinsEarned <= 100) &&
                (!('totalStars' in newData.englishAdventure) || newData.englishAdventure.totalStars <= 15)
              )
            : (
                (
                  !('adventureXpEarned' in oldData.englishAdventure) ||
                  !('adventureXpEarned' in newData.englishAdventure) ||
                  (
                    newData.englishAdventure.adventureXpEarned >= oldData.englishAdventure.adventureXpEarned &&
                    (newData.englishAdventure.adventureXpEarned - oldData.englishAdventure.adventureXpEarned) <= 1500
                  )
                ) &&
                (
                  !('adventureCoinsEarned' in oldData.englishAdventure) ||
                  !('adventureCoinsEarned' in newData.englishAdventure) ||
                  (
                    newData.englishAdventure.adventureCoinsEarned >= oldData.englishAdventure.adventureCoinsEarned &&
                    (newData.englishAdventure.adventureCoinsEarned - oldData.englishAdventure.adventureCoinsEarned) <= 100
                  )
                ) &&
                (
                  !('totalStars' in oldData.englishAdventure) ||
                  !('totalStars' in newData.englishAdventure) ||
                  (
                    newData.englishAdventure.totalStars >= oldData.englishAdventure.totalStars &&
                    (newData.englishAdventure.totalStars - oldData.englishAdventure.totalStars) <= 15
                  )
                )
              )
        )
      );
    }

    function isValidAttemptPayload(data) {
      return data.keys().hasAll(['attemptId', 'score', 'completedAt']) &&
        data.attemptId is string && data.attemptId.size() <= 128 &&
        data.score is number && data.score >= 0 && data.score <= 100 &&
        data.completedAt is string && data.completedAt.size() <= 64 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
        (!('moduleType' in data) || data.moduleType in [
          'dictation', 'flashcard', 'quiz', 'speaking', 'daily_challenge',
          'grammar', 'reading', 'writing', 'escape_room', 'listening_cinema',
          'grammar_battle', 'tutor', 'dialogue', 'city_map', 'arcade', 'adventure', 'smart_memory'
        ]);
    }

    function isValidFlashcardPayload(data) {
      return data.keys().hasAll(['cardId', 'repetitions', 'easeFactor']) &&
        data.cardId is string && data.cardId.size() <= 128 &&
        data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 500 &&
        data.easeFactor is number && data.easeFactor >= 1.0 && data.easeFactor <= 5.0;
    }

    function isValidTutorSessionPayload(data) {
      return data.keys().hasAll(['sessionId', 'mode', 'turnsCount', 'fluencyScore', 'completedAt']) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.mode in [
          'free_conversation', 'school_english', 'everyday_english',
          'travel_english', 'restaurant_english', 'job_interview',
          'debate_argumentation', 'exam_preparation', 'storytelling'
        ] &&
        data.turnsCount is number && data.turnsCount >= 0 && data.turnsCount <= 500 &&
        data.fluencyScore is number && data.fluencyScore >= 0 && data.fluencyScore <= 100 &&
        data.completedAt is string && data.completedAt.size() <= 64 &&
        (!('strengths' in data) || (data.strengths is list && data.strengths.size() <= 10)) &&
        (!('weaknessesIdentified' in data) || (data.weaknessesIdentified is list && data.weaknessesIdentified.size() <= 15));
    }

    function isValidAdventureClaimPayload(data, claimId) {
      return data.keys().hasAll(['claimId', 'xpAwarded', 'coinsAwarded', 'accuracy', 'claimedAt']) &&
        data.claimId is string && data.claimId == claimId && data.claimId.size() >= 1 && data.claimId.size() <= 128 &&
        data.xpAwarded is number && data.xpAwarded >= 0 && data.xpAwarded <= 350 &&
        data.coinsAwarded is number && data.coinsAwarded >= 0 && data.coinsAwarded <= 100 &&
        data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100 &&
        data.claimedAt is string && data.claimedAt.size() <= 64 &&
        (!('missionId' in data) || (data.missionId is string && data.missionId.size() <= 80)) &&
        (!('islandId' in data) || (data.islandId is string && data.islandId.size() <= 80));
    }

    function isValidSmartMemoryPayload(data, itemId) {
      return data.keys().hasAll([
          'itemId', 'normalizedKey', 'itemType', 'english', 'french',
          'cefrLevel', 'topic', 'difficulty', 'state', 'repetitions',
          'intervalDays', 'easeFactor', 'nextReviewDate', 'timezone',
          'recallHistory', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'itemId', 'normalizedKey', 'itemType', 'english', 'french',
          'pronunciation', 'exampleSentence', 'cefrLevel', 'topic', 'difficulty',
          'state', 'repetitions', 'intervalDays', 'easeFactor', 'retentionScore',
          'nextReviewDate', 'lastReviewedAt', 'timezone', 'nextReviewLocalDay',
          'totalReviews', 'correctReviews', 'lastOutcome', 'lastResponseTimeMs',
          'lastConfidence', 'lastMode', 'recallHistory', 'createdAt', 'updatedAt'
        ]) &&
        data.itemId is string && data.itemId == itemId && isValidId(itemId) &&
        data.normalizedKey is string && data.normalizedKey.size() >= 1 && data.normalizedKey.size() <= 200 &&
        data.itemType in ['vocabulary', 'expression', 'grammar', 'irregular_verb'] &&
        data.english is string && data.english.size() >= 1 && data.english.size() <= 240 &&
        data.french is string && data.french.size() >= 1 && data.french.size() <= 400 &&
        (!('pronunciation' in data) || (data.pronunciation is string && data.pronunciation.size() <= 160)) &&
        (!('exampleSentence' in data) || (data.exampleSentence is string && data.exampleSentence.size() <= 500)) &&
        isValidCefrLevel(data.cefrLevel) &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120 &&
        data.difficulty in ['easy', 'medium', 'hard'] &&
        data.state in ['new', 'learning', 'review', 'mastered'] &&
        data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 1000 &&
        data.intervalDays is number && data.intervalDays >= 0 && data.intervalDays <= 3650 &&
        data.easeFactor is number && data.easeFactor >= 1.1 && data.easeFactor <= 4.0 &&
        (!('retentionScore' in data) || (data.retentionScore is number && data.retentionScore >= 0 && data.retentionScore <= 100)) &&
        data.nextReviewDate is string && data.nextReviewDate.size() >= 10 && data.nextReviewDate.size() <= 64 &&
        (!('lastReviewedAt' in data) || (data.lastReviewedAt is string && data.lastReviewedAt.size() <= 64)) &&
        data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 80 &&
        (!('nextReviewLocalDay' in data) || (data.nextReviewLocalDay is string && data.nextReviewLocalDay.size() <= 20)) &&
        (!('totalReviews' in data) || (data.totalReviews is number && data.totalReviews >= 0 && data.totalReviews <= 5000)) &&
        (!('correctReviews' in data) || (data.correctReviews is number && data.correctReviews >= 0 && data.correctReviews <= 5000)) &&
        (!('lastOutcome' in data) || data.lastOutcome in ['incorrect', 'hard', 'correct', 'easy']) &&
        (!('lastResponseTimeMs' in data) || (data.lastResponseTimeMs is number && data.lastResponseTimeMs >= 0 && data.lastResponseTimeMs <= 600000)) &&
        (!('lastConfidence' in data) || (data.lastConfidence is number && data.lastConfidence >= 1 && data.lastConfidence <= 3)) &&
        (!('lastMode' in data) || (data.lastMode is string && data.lastMode.size() <= 40)) &&
        data.recallHistory is list && data.recallHistory.size() <= 25 &&
        data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    function isValidSmartMemoryDuelPayload(data, duelId) {
      return data.keys().hasAll([
          'duelId', 'status', 'cefrLevel', 'mode', 'cardIds',
          'hostUid', 'hostName', 'hostScore', 'hostCorrectCount',
          'hostAnsweredCount', 'hostTotalTimeMs', 'hostStreak', 'hostAnswers',
          'guestScore', 'guestCorrectCount', 'guestAnsweredCount',
          'guestTotalTimeMs', 'guestStreak', 'guestAnswers',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'duelId', 'status', 'cefrLevel', 'mode', 'cardIds',
          'hostUid', 'hostName', 'guestUid', 'guestName',
          'hostScore', 'hostCorrectCount', 'hostAnsweredCount', 'hostTotalTimeMs', 'hostStreak', 'hostBestStreak', 'hostAnswers',
          'guestScore', 'guestCorrectCount', 'guestAnsweredCount', 'guestTotalTimeMs', 'guestStreak', 'guestBestStreak', 'guestAnswers',
          'winnerUid', 'createdAt', 'startedAt', 'finishedAt', 'updatedAt'
        ]) &&
        data.duelId is string && data.duelId == duelId && isValidId(duelId) &&
        data.status in ['waiting', 'active', 'finished'] &&
        isValidCefrLevel(data.cefrLevel) &&
        data.mode in ['mixed', 'en_to_fr', 'fr_to_en', 'multiple_choice', 'complete_sentence'] &&
        data.cardIds is list && data.cardIds.size() == 10 && data.cardIds[0] is string &&
        data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80 &&
        (!('guestUid' in data) || data.guestUid == null || (data.guestUid is string && data.guestUid.size() >= 1 && data.guestUid.size() <= 128)) &&
        (!('guestName' in data) || data.guestName == null || (data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 80)) &&
        data.hostScore is number && data.hostScore >= 0 && data.hostScore <= 25000 &&
        data.hostCorrectCount is number && data.hostCorrectCount >= 0 && data.hostCorrectCount <= 10 &&
        data.hostAnsweredCount is number && data.hostAnsweredCount >= 0 && data.hostAnsweredCount <= 10 &&
        data.hostTotalTimeMs is number && data.hostTotalTimeMs >= 0 && data.hostTotalTimeMs <= 3600000 &&
        data.hostStreak is number && data.hostStreak >= 0 && data.hostStreak <= 10 &&
        (!('hostBestStreak' in data) || (data.hostBestStreak is number && data.hostBestStreak >= 0 && data.hostBestStreak <= 10)) &&
        data.hostAnswers is list && data.hostAnswers.size() <= 10 &&
        data.guestScore is number && data.guestScore >= 0 && data.guestScore <= 25000 &&
        data.guestCorrectCount is number && data.guestCorrectCount >= 0 && data.guestCorrectCount <= 10 &&
        data.guestAnsweredCount is number && data.guestAnsweredCount >= 0 && data.guestAnsweredCount <= 10 &&
        data.guestTotalTimeMs is number && data.guestTotalTimeMs >= 0 && data.guestTotalTimeMs <= 3600000 &&
        data.guestStreak is number && data.guestStreak >= 0 && data.guestStreak <= 10 &&
        (!('guestBestStreak' in data) || (data.guestBestStreak is number && data.guestBestStreak >= 0 && data.guestBestStreak <= 10)) &&
        data.guestAnswers is list && data.guestAnswers.size() <= 10 &&
        (!('winnerUid' in data) || data.winnerUid == null || (data.winnerUid is string && data.winnerUid.size() <= 128)) &&
        data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64 &&
        (!('startedAt' in data) || data.startedAt == null || (data.startedAt is string && data.startedAt.size() <= 64)) &&
        (!('finishedAt' in data) || data.finishedAt == null || (data.finishedAt is string && data.finishedAt.size() <= 64)) &&
        data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection verification document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Scholar profile document & isolated subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserPayload(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('level' in request.resource.data) || isValidCefrLevel(request.resource.data.level)) &&
        (!('schoolGrade' in request.resource.data) || isValidGrade(request.resource.data.schoolGrade)) &&
        (!('ageRange' in request.resource.data) || isValidAgeRange(request.resource.data.ageRange)) &&
        (!('learningObjectives' in request.resource.data) || (request.resource.data.learningObjectives is list && request.resource.data.learningObjectives.size() <= 8)) &&
        (!('preferredDurationMinutes' in request.resource.data) || (request.resource.data.preferredDurationMinutes is number && request.resource.data.preferredDurationMinutes >= 5 && request.resource.data.preferredDurationMinutes <= 180)) &&
        (!('placementTest' in request.resource.data) || request.resource.data.placementTest is map) &&
        (!('favoriteLessonIds' in request.resource.data) || (request.resource.data.favoriteLessonIds is list && request.resource.data.favoriteLessonIds.size() <= 200)) &&
        (!('chartAnnotations' in request.resource.data) || (request.resource.data.chartAnnotations is list && request.resource.data.chartAnnotations.size() <= 60)) &&
        (!('tutorSavedNotes' in request.resource.data) || (request.resource.data.tutorSavedNotes is list && request.resource.data.tutorSavedNotes.size() <= 40)) &&
        (!('tutorWeaknesses' in request.resource.data) || (request.resource.data.tutorWeaknesses is list && request.resource.data.tutorWeaknesses.size() <= 30)) &&
        isValidXpUpdate(resource.data, request.resource.data) &&
        isValidAdventureDelta(resource.data, request.resource.data);
      allow delete: if isOwner(userId);

      // Private learning attempts subcollection
      match /attempts/{attemptId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAttemptPayload(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Private SM-2 flashcard progress subcollection
      match /flashcardProgress/{cardId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFlashcardPayload(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Private AI English Tutor sessions subcollection
      match /tutorSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(sessionId) && isValidTutorSessionPayload(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Write-once immutable English Adventure reward claims ledger (prevents duplicate claims)
      match /adventureClaims/{claimId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(claimId) && isValidAdventureClaimPayload(request.resource.data, claimId);
        allow update, delete: if false;
      }

      // Deduplicated Smart Memory spaced repetition & recall history records
      match /smartMemoryRecords/{itemId} {
        allow read: if isOwner(userId) && isValidId(itemId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidSmartMemoryPayload(request.resource.data, itemId);
        allow update: if isOwner(userId) && isValidId(itemId) && isValidSmartMemoryPayload(request.resource.data, itemId) &&
          request.resource.data.itemId == resource.data.itemId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(itemId);
      }
    }

    // Shared real-time Smart Memory 10-card duel rooms
    match /smartMemoryDuels/{duelId} {
      allow get: if isSignedIn() && isValidId(duelId) && (
        resource == null ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.guestUid == request.auth.uid ||
        resource.data.status == 'waiting'
      );
      allow list: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.guestUid == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(duelId) &&
        isValidSmartMemoryDuelPayload(request.resource.data, duelId) &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.guestUid == null &&
        request.resource.data.status == 'waiting';
      allow update: if isSignedIn() && isValidId(duelId) &&
        isValidSmartMemoryDuelPayload(request.resource.data, duelId) &&
        resource.data.status != 'finished' &&
        request.resource.data.duelId == resource.data.duelId &&
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.cardIds == resource.data.cardIds && (
          // Action: friend joins waiting duel room
          (
            resource.data.status == 'waiting' &&
            resource.data.guestUid == null &&
            request.resource.data.guestUid == request.auth.uid &&
            request.auth.uid != resource.data.hostUid &&
            request.resource.data.status == 'active' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'guestName', 'status', 'startedAt', 'updatedAt'])
          ) ||
          // Action: host submits answer progress / final scoreboard
          (
            request.auth.uid == resource.data.hostUid &&
            request.resource.data.guestUid == resource.data.guestUid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'hostScore', 'hostCorrectCount', 'hostAnsweredCount', 'hostTotalTimeMs',
              'hostStreak', 'hostBestStreak', 'hostAnswers', 'status', 'winnerUid',
              'finishedAt', 'updatedAt'
            ])
          ) ||
          // Action: guest submits answer progress / final scoreboard
          (
            resource.data.guestUid == request.auth.uid &&
            request.resource.data.guestUid == resource.data.guestUid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'guestScore', 'guestCorrectCount', 'guestAnsweredCount', 'guestTotalTimeMs',
              'guestStreak', 'guestBestStreak', 'guestAnswers', 'status', 'winnerUid',
              'finishedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(duelId) && resource.data.hostUid == request.auth.uid;
    }
  }
}
